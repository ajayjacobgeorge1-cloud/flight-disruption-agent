# Copy to .env and fill in the real key. Never commit the real .env.
LLM_API_BASE_URL=http://llm-platform-alb-1231835738.us-east-1.elb.amazonaws.com/v1/chat/completions
LLM_API_KEY=PLACEHOLDER_API_KEY
LLM_MODEL=gemini-2.0-flash

# Judge model used by the eval pipeline can be the same or a different deployment.
EVAL_JUDGE_MODEL=gemini-2.0-flash

# Business rule: rebook actions with a fare difference at/above this amount (USD)
# are denied by the PreToolUse hook and routed to human escalation.
REBOOKING_AUTONOMY_THRESHOLD_USD=750
